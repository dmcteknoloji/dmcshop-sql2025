# DMCShop ortam değişkenleri — .env.example
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# .env .gitignore'da; commit edilmez.

# ============================================================================
# Local docker compose
# ============================================================================

# SQL Server SA password (en az 8 karakter, büyük + küçük + rakam + simge).
# Varsayılan YOK. Boş bırakırsan scripts/setup.sh bir kez rastgele üretip
# scripts/.env içine (0600) yazar. Kendi değerini vermek istersen doldur.
DMCSHOP_SA_PASSWORD=

# SQL Server host (docker compose içinden veya host'tan)
DMCSHOP_HOST=localhost,1433

# Ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct-q4_K_M

# Embedding batch size — B4ms üzerinde 32, daha güçlü VM'de 64+
EMBED_BATCH=32

# Veri ölçeği: showcase (120 ürün) veya large (50K ürün)
DMCSHOP_SCALE=showcase

# ============================================================================
# Azure deployment
# ============================================================================

# Resource Group (deploy.sh / teardown.sh / sync.sh)
DMCSHOP_RG=rg-dmcshop-demo

# Azure region — westeurope (germanywestcentral'da B-series capacity sorunu)
DMCSHOP_LOCATION=westeurope

# VM size — B4ms önerilen (16 GB RAM, chat modeli için)
DMCSHOP_VM_SIZE=Standard_B4ms

# SSH erişimi — production için kendi IP/32 ile daralt
# Örnek: DMCSHOP_ALLOWED_CIDR=85.105.42.7/32
DMCSHOP_ALLOWED_CIDR=*

# SSH key
DMCSHOP_SSH_KEY=$HOME/.ssh/dmcshop_ed25519

# ============================================================================
# .NET uygulaması (appsettings.Local.json override için)
# ============================================================================

# Provider — openai veya ollama
DMCSHOP_PROVIDER__ACTIVE=ollama

# Azure OpenAI (Provider:Active=openai için)
DMCSHOP_PROVIDER__OPENAI__ENDPOINT=
DMCSHOP_PROVIDER__OPENAI__APIKEY=
