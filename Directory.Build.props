<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>tr-TR</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Company>DMC Bilgi Teknolojileri</Company>
    <Authors>Çağlar Özenç</Authors>
    <Copyright>Copyright (c) 2026 Çağlar Özenç</Copyright>
    <Product>DMCShop</Product>
    <RepositoryUrl>https://github.com/dmcteknoloji/dmcshop-sql2025</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
