<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DMCShop.Web</RootNamespace>
    <AssemblyName>DMCShop.Web</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DMCShop.Domain\DMCShop.Domain.csproj" />
    <ProjectReference Include="..\DMCShop.Data\DMCShop.Data.csproj" />
    <ProjectReference Include="..\DMCShop.Providers\DMCShop.Providers.csproj" />
    <ProjectReference Include="..\DMCShop.Search\DMCShop.Search.csproj" />
  </ItemGroup>

  <!-- Senaryo sayfalarindaki "arkada calisan T-SQL" paneli bu dosyalari
       calisma aninda okuyor. Kopyalamak, ekranda yazan sorgunun depodaki
       betikle ayni kalmasini sagliyor. -->
  <ItemGroup>
    <None Include="../../../sql/2*.sql" LinkBase="sql-snippets">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
