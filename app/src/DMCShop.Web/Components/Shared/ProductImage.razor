@*
    ProductImage — kategori bazlı parlak gradient + ürün adı monogram.
    Variant'a göre boyut: hero (1:1), card (4:3), thumb (1:1 küçük).
    Emoji/icon yok — sadece tipografi + gradient kompozisyon.
*@

@if (CustomImage is { Length: > 0 })
{
    <div class="dmc-pimg dmc-pimg-@Variant" style="background: #FFFFFF; padding: 0; overflow: hidden;"
         role="img" aria-label="@Name">
        <img src="@CustomImage" alt="@Name"
             style="width: 100%; height: 100%; object-fit: contain; display: block;" />
    </div>
}
else
{
    <div class="dmc-pimg dmc-pimg-@Variant" style="@($"background: {Gradient};")"
         role="img" aria-label="@Name">
        @if (Glif is not null)
        {
            @* Urun adindan secilen cizim. Stok fotografi taklit etmiyoruz;
               amac monogram yerine taninabilir bir sekil koymak. *@
            <svg class="dmc-pimg-glif" viewBox="0 0 24 24" fill="none"
                 stroke="@Mono" stroke-width="1.4" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <path d="@Glif" />
            </svg>
        }
        else
        {
            <span class="dmc-pimg-mono" style="@($"color: {Mono};")">@Monogram</span>
        }
        @if (Variant != "thumb")
        {
            <span class="dmc-pimg-watermark">@SkuOrId</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public int    ProductId    { get; set; }
    [Parameter, EditorRequired] public string Name         { get; set; } = string.Empty;
    [Parameter] public string? CategoryName { get; set; }
    [Parameter] public string? Sku          { get; set; }

    /// <summary>"hero" (1:1), "card" (4:3), "thumb" (64px)</summary>
    [Parameter] public string Variant { get; set; } = "card";

    private string Monogram => BuildMonogram(Name);
    private string? Glif     => ProductGlyph.Bul(Name, CategoryName);
    private string SkuOrId  => Sku ?? $"#{ProductId}";

    /// <summary>Özel kapak/görsel URL'i olan ürünler. Diğerleri monogram gradient.</summary>
    private string? CustomImage => ProductId switch
    {
        100001 => "brand/book-cover-sql2025.svg",   // SQL Server 2025: Herkes İçin, Her Rol İçin
        _      => null
    };

    private (string from, string to, string mono) Palette =>
        CategoryName switch
        {
            "Kitap"      => ("#F4D7A1", "#E8A553", "#5C2E0E"),   // amber → caramel
            "Elektronik" => ("#A5D8FF", "#5C7CFA", "#1A237E"),   // sky → indigo
            "Gıda"       => ("#FFD8A8", "#F76707", "#5C2400"),   // peach → orange
            "Giyim"      => ("#E5C9FF", "#9775FA", "#311B6B"),   // lavender → violet
            "Ev"         => ("#B2F2BB", "#37B24D", "#0E3320"),   // mint → forest
            "Hobi"       => ("#FFC9C9", "#F03E3E", "#5C0E0E"),   // blush → red
            // Katalogda 100 kategori var, elle boyanmis alti tanesi disindaki
            // her sey griye dusuyordu. Kategori adindan tureyen sabit bir renk
            // uretiyoruz: ayni kategori her zaman ayni rengi aliyor.
            _            => DerivedPalette(CategoryName)
        };

    /// <summary>Kategori adindan deterministik pastel gradient uretir.</summary>
    private static (string from, string to, string mono) DerivedPalette(string? category)
    {
        if (string.IsNullOrWhiteSpace(category))
            return ("#DEE2E6", "#868E96", "#212529");

        // FNV-1a: kisa, stabil ve platformdan bagimsiz. string.GetHashCode()
        // surec basina rastgeleleniyor, kullanilamaz.
        uint hash = 2166136261;
        foreach (var ch in category)
        {
            hash ^= ch;
            hash *= 16777619;
        }

        var hue = (int)(hash % 360);
        return ($"hsl({hue} 78% 82%)", $"hsl({hue} 62% 48%)", $"hsl({hue} 70% 18%)");
    }

    private string Gradient => $"linear-gradient(135deg, {Palette.from} 0%, {Palette.to} 100%)";
    private string Mono     => Palette.mono;

    private static string BuildMonogram(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "—";
        var words = name.Split(new[] { ' ', '-', '/' }, StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0) return "—";
        if (words.Length == 1) return words[0].Length >= 2 ? words[0][..2].ToUpper() : words[0][..1].ToUpper();
        return $"{char.ToUpper(words[0][0])}{char.ToUpper(words[1][0])}";
    }
}
