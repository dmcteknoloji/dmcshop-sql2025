@inherits LayoutComponentBase

<FluentDesignTheme Mode="DesignThemeModes.Dark" CustomColor="#A4262C" StorageName="dmcshop-theme" />

<div class="dmc-shell">

    <header class="dmc-header">
        <a href="/" class="dmc-brand" style="text-decoration:none; color:inherit;">
            <span class="dmc-brand-logo"><img src="brand/dmc-logo.png" alt="DMC" /></span>
            <span class="dmc-brand-divider"></span>
            <span class="dmc-brand-title">DMCShop</span>
        </a>

        <nav class="dmc-nav">
            <NavLink href="" Match="NavLinkMatch.All">Anasayfa</NavLink>
            <NavLink href="katalog">Katalog</NavLink>
            <NavLink href="search">Semantik arama</NavLink>
            <NavLink href="bana-ozel">Sana özel</NavLink>
            <NavLink href="asistan">Asistan</NavLink>
            <NavLink href="fraud">Fraud</NavLink>
            <NavLink href="harita">Harita</NavLink>
            <a href="https://github.com/dmcteknoloji/dmcshop-sql2025" target="_blank" rel="noreferrer">GitHub</a>
        </nav>
    </header>

    <main class="dmc-main">
        @Body
    </main>

    <footer class="dmc-footer">
        <div class="dmc-footer-inner">
            <div>
                <strong>DMC Bilgi Teknolojileri</strong> — SQL Server 2025 referans uygulaması
            </div>
            <div class="dmc-footer-stack">
                <span class="dmc-badge">SQL Server 2025 RTM-CU4</span>
                <span class="dmc-badge">.NET 10</span>
                <span class="dmc-badge">EF Core 10</span>
                <a href="https://dmcteknoloji.com" target="_blank" rel="noreferrer">dmcteknoloji.com</a>
            </div>
        </div>
    </footer>

</div>

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />

<div id="blazor-error-ui" data-nosnippet>
    Beklenmedik bir hata oluştu.
    <a href="." class="reload">Yeniden yükle</a>
    <span class="dismiss">x</span>
</div>
