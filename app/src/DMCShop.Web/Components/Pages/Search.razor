@page "/search"
@rendermode InteractiveServer
@using System.Diagnostics
@using DMCShop.Domain.Abstractions
@using DMCShop.Domain.Dtos
@using DMCShop.Search
@inject VectorSearchService SearchSvc
@inject IEmbeddingProvider Provider

<PageTitle>Semantik arama — DMCShop</PageTitle>

<section class="dmc-hero">
    <div class="dmc-hero-eyebrow">Senaryo 1</div>
    <h1>Anlam tabanlı ürün araması</h1>
    <p class="dmc-hero-lead">
        Hybrid retrieval: VECTOR_SEARCH + DiskANN ile cosine yakın 300 aday çekilir, ardından
        sorgudaki anahtar terimlerle keyword overlap rerank uygulanır. Pure vector kalitesi 50K
        ürün arasında generic terim baskınlığında bozulabilir; hybrid bunu telafi eder. Sağdaki
        klasik <code>LIKE</code> sütunu çoğu doğal dil sorgusunda sıfır sonuç verir.
    </p>
    <div class="dmc-stack-row">
        <span class="dmc-badge dmc-badge-accent">Provider: @Provider.Name</span>
        <span class="dmc-badge">@Provider.ModelName</span>
        <span class="dmc-badge">@Provider.Dimensions dim</span>
    </div>
</section>

<div class="dmc-search-row">
    <input @bind="query" @bind:event="oninput" @onkeydown="HandleKey"
           class="dmc-search-input" placeholder="Bir ürün arayın — anlamsal olarak…" />
    <button class="dmc-btn dmc-btn-dark" @onclick="RunAsync" disabled="@busy">
        @(busy ? "Aranıyor…" : "Ara")
    </button>
</div>

<div class="dmc-chip-row">
    <span class="dmc-chip-label">Örnek</span>
    @foreach (var sample in samples)
    {
        <button class="dmc-chip" @onclick="() => SelectAndRun(sample)">@sample</button>
    }
</div>

@if (error is not null)
{
    <div class="dmc-alert dmc-alert-error">@error</div>
}

@if (vectorHits is not null || likeHits is not null)
{
    <div class="dmc-grid dmc-grid-2">
        <div>
            <div class="dmc-section-head">
                <span class="dmc-panel-title">Hybrid · vector + keyword rerank</span>
                <span class="dmc-section-meta">@vectorLatencyMs ms · top @(vectorHits?.Count ?? 0)</span>
            </div>
            @if (vectorHits is null || vectorHits.Count == 0)
            {
                <div class="dmc-empty">Sonuç yok.</div>
            }
            else
            {
                <div class="dmc-grid dmc-results-grid dmc-results-grid-compact">
                    @foreach (var h in vectorHits)
                    {
                        <a href="urun/@h.ProductId" class="dmc-pcard">
                            <ProductImage ProductId="h.ProductId" Name="h.Name" CategoryName="h.CategoryName" Sku="h.Sku" Variant="card" />
                            <div class="dmc-pcard-body">
                                <div class="dmc-pcard-cat">@h.CategoryName</div>
                                <h3 class="dmc-pcard-name">@h.Name</h3>
                                <div class="dmc-pcard-price">@h.Price.ToString("N2") ₺</div>
                                <div class="dmc-hit-score">
                                    <span class="dmc-hit-score-num">@h.Distance.ToString("F4")</span>
                                    <span class="dmc-hit-bar">
                                        <span class="dmc-hit-bar-fill" style="width: @(SimilarityPct(h.Distance))%; display: block;"></span>
                                    </span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

        <div>
            <div class="dmc-section-head">
                <span class="dmc-panel-title">LIKE · lexical eşleşme</span>
                <span class="dmc-section-meta">@likeLatencyMs ms · top @(likeHits?.Count ?? 0)</span>
            </div>
            @if (likeHits is null || likeHits.Count == 0)
            {
                <div class="dmc-empty">Bu sorgu için lexical eşleşme bulunamadı.</div>
            }
            else
            {
                <div class="dmc-grid dmc-results-grid dmc-results-grid-compact">
                    @foreach (var h in likeHits)
                    {
                        <a href="urun/@h.ProductId" class="dmc-pcard">
                            <ProductImage ProductId="h.ProductId" Name="h.Name" CategoryName="h.CategoryName" Sku="h.Sku" Variant="card" />
                            <div class="dmc-pcard-body">
                                <div class="dmc-pcard-cat">@h.CategoryName</div>
                                <h3 class="dmc-pcard-name">@h.Name</h3>
                                <div class="dmc-pcard-price">@h.Price.ToString("N2") ₺</div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private string query = string.Empty;
    private bool busy;
    private string? error;
    private IReadOnlyList<ProductHit>? vectorHits;
    private IReadOnlyList<ProductHit>? likeHits;
    private long vectorLatencyMs;
    private long likeLatencyMs;

    private static readonly string[] samples =
    {
        "rahat ergonomik klavye",
        "kahve çekirdeği tek menşe",
        "kış için sıcak yün kazak",
        "ofis için ergonomik mouse",
        "tek elime sığacak okuma cihazı",
        "doğal el dokuma"
    };

    private async Task RunAsync()
    {
        if (string.IsNullOrWhiteSpace(query)) return;

        busy  = true;
        error = null;
        try
        {
            var vSw = Stopwatch.StartNew();
            var vectorTask = SearchSvc.HybridSearchAsync(query, topK: 6);
            var lSw = Stopwatch.StartNew();
            var likeTask = SearchSvc.LikeSearchAsync(query, topK: 6);

            await Task.WhenAll(vectorTask, likeTask);

            vSw.Stop();  lSw.Stop();
            vectorHits = await vectorTask;
            likeHits   = await likeTask;
            vectorLatencyMs = vSw.ElapsedMilliseconds;
            likeLatencyMs   = lSw.ElapsedMilliseconds;
        }
        catch (Exception ex)
        {
            error = $"Arama başarısız: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SelectAndRun(string sample)
    {
        query = sample;
        await RunAsync();
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RunAsync();
    }

    private static int SimilarityPct(double distance) =>
        Math.Max(0, Math.Min(100, (int)((1.0 - distance / 2.0) * 100)));
}
