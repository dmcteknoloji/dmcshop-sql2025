@page "/fraud"
@rendermode InteractiveServer
@using DMCShop.Domain.Dtos
@using DMCShop.Search
@inject FraudRingService Detection

<PageTitle>Fraud ring tespiti — DMCShop</PageTitle>

<section class="dmc-hero">
    <div class="dmc-hero-eyebrow">Senaryo 3</div>
    <h1>Fraud ring tespiti</h1>
    <p class="dmc-hero-lead">
        Aynı cihazı, IP adresini veya kart parmak izini paylaşan müşterileri tek bir SQL sorgusuyla
        ortaya çıkarır. Risk seviyesi paylaşılan sinyal sayısına göre derecelendirilir.
        Workshop için sql/22-fraud-ring.sql içinde SHORTEST_PATH evidence chain örneği var.
    </p>
</section>

<div class="dmc-toolbar">
    <div class="dmc-toolbar-count">
        @if (summary is not null)
        {
            <strong style="color:var(--text);">@summary.Total.ToString("N0")</strong>
            <span> ring</span>
            @if (summary.HighCount > 0)
            {
                <span class="dmc-badge dmc-badge-high" style="margin-left: 0.8rem;">@summary.HighCount HIGH</span>
            }
            @if (summary.MediumCount > 0)
            {
                <span class="dmc-badge dmc-badge-medium" style="margin-left: 0.4rem;">@summary.MediumCount MEDIUM</span>
            }
            <span style="margin-left: 0.8rem;">·</span>
            <span style="margin-left: 0.4rem;" class="dmc-badge dmc-badge-soft">@summary.DeviceCount cihaz</span>
            <span class="dmc-badge dmc-badge-soft">@summary.IpCount IP</span>
            <span class="dmc-badge dmc-badge-soft">@summary.CardCount kart</span>
        }
    </div>
    <div class="dmc-toolbar-sort">
        <input class="dmc-search-input" style="height: 38px; padding: 0.5rem 0.85rem; min-width: 240px;"
               @bind="search" @bind:event="oninput" @bind:after="ResetPageAndLoad" placeholder="Müşteri veya pattern ara…" />
        <select class="dmc-select" @bind="riskFilter" @bind:after="ResetPageAndLoad">
            <option value="">Tüm riskler</option>
            <option value="HIGH">Sadece HIGH</option>
            <option value="MEDIUM">Sadece MEDIUM</option>
        </select>
        <select class="dmc-select" @bind="patternFilter" @bind:after="ResetPageAndLoad">
            <option value="">Tüm patternler</option>
            <option value="shared_device">Paylaşılan cihaz</option>
            <option value="shared_ip">Paylaşılan IP</option>
            <option value="shared_card">Paylaşılan kart</option>
        </select>
        <select class="dmc-select" @bind="sortBy" @bind:after="ResetPageAndLoad">
            <option value="count-desc">En fazla müşteri</option>
            <option value="count-asc">En az müşteri</option>
            <option value="risk">Risk seviyesi (HIGH önce)</option>
            <option value="pattern">Pattern (alfabetik)</option>
        </select>
        <button class="dmc-btn dmc-btn-ghost" style="height: 38px; padding: 0 0.85rem;" @onclick="LoadAsync" disabled="@busy">
            @(busy ? "Taranıyor…" : "Yenile")
        </button>
    </div>
</div>

@if (error is not null)
{
    <div class="dmc-alert dmc-alert-error">@error</div>
}

@if (busy && currentPageRings is null)
{
    <div class="dmc-loading">Fraud ringleri taranıyor…</div>
}
else if (currentPageRings is { Count: 0 })
{
    <div class="dmc-empty">
        @if (summary is { Total: 0 })
        {
            <span>Şu anda risk taşıyan herhangi bir ring tespit edilemedi.</span>
        }
        else
        {
            <span>Filtre ile eşleşen ring yok.</span>
        }
    </div>
}
else if (currentPageRings is not null)
{
    <div class="dmc-grid" style="gap: 0.85rem;">
        @foreach (var r in currentPageRings)
        {
            <div class="dmc-card">
                <div class="dmc-fraud-head">
                    <div style="display:flex; gap: 0.4rem; flex-wrap: wrap; align-items: center;">
                        <span class="dmc-badge @RiskBadge(r.RiskLevel)">@r.RiskLevel risk</span>
                        <span class="dmc-badge dmc-badge-soft">@PatternLabel(r.Pattern)</span>
                    </div>
                    <div style="text-align:right;">
                        <div style="font-size: 1.8rem; font-weight: 700; line-height:1; font-variant-numeric: tabular-nums;">@r.CustomerCount</div>
                        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 4px;">müşteri</div>
                    </div>
                </div>

                <div class="dmc-fraud-evidence">@r.Evidence</div>

                <div>
                    <div class="dmc-panel-title" style="margin-bottom: 0.45rem;">Bağlı müşteriler</div>
                    <div style="display:flex; flex-wrap: wrap; gap: 0.35rem;">
                        @foreach (var name in r.CustomerList.Split(", ", StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="dmc-badge dmc-badge-soft"
                                  style="@(MatchesSearch(name) ? "background: var(--accent-soft); border-color: var(--accent); color: var(--accent);" : null)">
                                @name
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="dmc-currentPager">
            <button class="dmc-btn dmc-btn-ghost" @onclick="() => GotoPage(1)"            disabled="@(currentPage <= 1)">«</button>
            <button class="dmc-btn dmc-btn-ghost" @onclick="() => GotoPage(currentPage - 1)"     disabled="@(currentPage <= 1)">‹ Önceki</button>
            <span class="dmc-currentPager-info">@currentPage / @totalPages</span>
            <button class="dmc-btn dmc-btn-ghost" @onclick="() => GotoPage(currentPage + 1)"     disabled="@(currentPage >= totalPages)">Sonraki ›</button>
            <button class="dmc-btn dmc-btn-ghost" @onclick="() => GotoPage(totalPages)"   disabled="@(currentPage >= totalPages)">»</button>
        </div>
    }
}

<style>
    .dmc-fraud-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }
    .dmc-fraud-evidence {
        font-size: 0.92rem;
        color: var(--text-muted);
        line-height: 1.55;
        padding: 0.6rem 0.85rem;
        background: var(--surface-2);
        border-left: 3px solid var(--accent);
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }
    .dmc-badge-high   { background: rgba(220,38,38,0.08); color: #B91C1C; border-color: rgba(220,38,38,0.25); font-weight: 600; }
    .dmc-badge-medium { background: rgba(180,83,9,0.08);  color: #B45309; border-color: rgba(180,83,9,0.25);  font-weight: 600; }
    .dmc-currentPager {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        padding: 1rem 0;
    }
    .dmc-currentPager .dmc-btn { height: 38px; padding: 0 0.85rem; font-size: 0.88rem; }
    .dmc-currentPager-info {
        font-family: var(--font-mono);
        color: var(--text-muted);
        padding: 0 0.85rem;
        font-variant-numeric: tabular-nums;
    }
</style>

@code {
    private const int PageSize = 20;

    private FraudSummary? summary;
    private List<FraudRing>? currentPageRings;
    private bool busy;
    private string? error;

    private int currentPage = 1;
    private int totalPages = 1;

    private string search        = string.Empty;
    private string riskFilter    = string.Empty;
    private string patternFilter = string.Empty;
    private string sortBy        = "count-desc";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        busy  = true;
        error = null;
        try
        {
            summary = await Detection.SummaryAsync(
                riskFilter:    NullIfEmpty(riskFilter),
                patternFilter: NullIfEmpty(patternFilter),
                search:        NullIfEmpty(search));

            totalPages = Math.Max(1, (int)Math.Ceiling(summary.Total / (double)PageSize));
            if (currentPage > totalPages) currentPage = totalPages;

            currentPageRings = await Detection.DetectAsync(
                skip: (currentPage - 1) * PageSize,
                take: PageSize,
                riskFilter:    NullIfEmpty(riskFilter),
                patternFilter: NullIfEmpty(patternFilter),
                search:        NullIfEmpty(search),
                sortBy:        sortBy);
        }
        catch (Exception ex)
        {
            error = $"Tarama başarısız: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetPageAndLoad()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task GotoPage(int p)
    {
        currentPage = Math.Max(1, Math.Min(totalPages, p));
        await LoadAsync();
    }

    private bool MatchesSearch(string name) =>
        !string.IsNullOrWhiteSpace(search) &&
        name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static string RiskBadge(string risk) => risk switch
    {
        "HIGH"   => "dmc-badge-high",
        "MEDIUM" => "dmc-badge-medium",
        _        => "dmc-badge"
    };

    private static string PatternLabel(string pattern) => pattern switch
    {
        "shared_device" => "Paylaşılan cihaz",
        "shared_ip"     => "Paylaşılan IP",
        "shared_card"   => "Paylaşılan kart",
        _               => pattern
    };
}
