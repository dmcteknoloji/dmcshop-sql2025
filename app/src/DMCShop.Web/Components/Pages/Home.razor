@page "/"
@using DMCShop.Data
@using Microsoft.EntityFrameworkCore
@inject DMCShopDbContext Db
@inject SqlServerVersionService SqlVersion

<PageTitle>DMCShop — SQL Server 2025 referans uygulaması</PageTitle>

<section class="dmc-hero">
    <div class="dmc-hero-eyebrow">DMC Bilgi Teknolojileri</div>
    <h1>SQL Server 2025'in vektör ve graf gücü, gerçek bir e-ticarette.</h1>
    <p class="dmc-hero-lead">
        DMCShop, SQL Server 2025'in yerleşik <strong style="color:var(--text);">VECTOR + DiskANN</strong>
        ve <strong style="color:var(--text);">GRAPH MATCH</strong> özelliklerinin üretim
        senaryolarındaki karşılığını gösteren açık kaynak referans uygulamadır. Gerçekçi bir e-ticaret
        kataloğu üzerinde anlamsal arama, ürün önerisi ve fraud tespiti uçtan uca çalışır.
    </p>

    <div class="dmc-hero-cta">
        <a href="katalog" class="dmc-btn dmc-btn-dark dmc-btn-lg">Kataloğa göz at</a>
        <a href="search"  class="dmc-btn dmc-btn-ghost dmc-btn-lg">Semantik arama</a>
    </div>

    <div class="dmc-stack-row">
        <span class="dmc-badge dmc-badge-accent">@sqlVersionLabel</span>
        <span class="dmc-badge">.NET 10 · Blazor Server</span>
        <span class="dmc-badge">EF Core 10</span>
        <span class="dmc-badge">Ollama nomic-embed-text · 768 dim</span>
    </div>
</section>

@if (featured is not null && featured.Count > 0)
{
    <section class="dmc-section">
        <div class="dmc-section-head">
            <span class="dmc-section-title">Öne çıkan ürünler</span>
            <a href="katalog" class="dmc-card-link" style="font-size: var(--fz-sm);">Tüm katalog (@productCount.ToString("N0")) →</a>
        </div>
        <div class="dmc-grid dmc-grid-cat">
            @foreach (var p in featured)
            {
                <a href="urun/@p.Id" class="dmc-pcard">
                    <ProductImage ProductId="p.Id" Name="p.Name" CategoryName="p.Category" Sku="p.Sku" Variant="card" />
                    <div class="dmc-pcard-body">
                        <div class="dmc-pcard-cat">@p.Category</div>
                        <h3 class="dmc-pcard-name">@p.Name</h3>
                        <div class="dmc-pcard-price">@p.Price.ToString("N2") ₺</div>
                    </div>
                </a>
            }
        </div>
    </section>
}

<section class="dmc-section">
    <div class="dmc-section-head">
        <span class="dmc-section-title">Demo senaryoları</span>
        <span class="dmc-section-meta">5 aktif</span>
    </div>

    <div class="dmc-grid dmc-grid-2">
        <a href="search" class="dmc-card">
            <span class="dmc-badge">Senaryo 1</span>
            <h3 class="dmc-card-title">Semantik ürün arama</h3>
            <p class="dmc-card-body">
                VECTOR_SEARCH + DiskANN ile yaklaşık kNN. "rahat ergonomik klavye" gibi anlam tabanlı
                sorgularda klasik LIKE'ın boş döndürdüğü durumlarda doğru ürünleri yakalar.
            </p>
            <div class="dmc-card-footer">
                <span class="dmc-badge dmc-badge-positive">Aktif</span>
                <span class="dmc-card-link">İncele →</span>
            </div>
        </a>

        <a href="urun/1041" class="dmc-card">
            <span class="dmc-badge">Senaryo 4</span>
            <h3 class="dmc-card-title">Bunu alanlar bunu da aldı</h3>
            <p class="dmc-card-body">
                Graph MATCH ile 2-hop ürün-müşteri-ürün geçişi. Co-purchase önerileri tek bir SQL
                sorgusuyla, ek bir öneri motoru kurmadan.
            </p>
            <div class="dmc-card-footer">
                <span class="dmc-badge dmc-badge-positive">Aktif</span>
                <span class="dmc-card-link">İncele →</span>
            </div>
        </a>

        <a href="asistan" class="dmc-card">
            <span class="dmc-badge">Senaryo 2</span>
            <h3 class="dmc-card-title">RAG tabanlı ürün asistanı</h3>
            <p class="dmc-card-body">
                Vector retrieval + chat completion. Sohbet ekranından sorulan soruya en uygun ürünleri
                çekip doğal dilde özet yanıt üretir. Tüm çağrılar <code>vector.query_log</code>'a yazılır.
            </p>
            <div class="dmc-card-footer">
                <span class="dmc-badge dmc-badge-positive">Aktif</span>
                <span class="dmc-card-link">İncele →</span>
            </div>
        </a>

        <a href="fraud" class="dmc-card">
            <span class="dmc-badge">Senaryo 3</span>
            <h3 class="dmc-card-title">Fraud ring tespiti</h3>
            <p class="dmc-card-body">
                SHORTEST_PATH ile aynı cihaz, IP veya ödeme aracını paylaşan müşteri kümelerini
                tespit eder. Tek SQL sorgusunda kanıt zincirini metin olarak döner.
            </p>
            <div class="dmc-card-footer">
                <span class="dmc-badge dmc-badge-positive">Aktif</span>
                <span class="dmc-card-link">İncele →</span>
            </div>
        </a>

        <a href="bana-ozel" class="dmc-card" style="grid-column: 1 / -1; border-color: var(--accent);">
            <span class="dmc-badge dmc-badge-accent">Senaryo 5 · Vector + Graph hibrit</span>
            <h3 class="dmc-card-title">Sana özel — kişiselleştirilmiş öneri</h3>
            <p class="dmc-card-body">
                Müşterinin son siparişlerindeki ürünlerin <strong style="color:var(--text);">vector
                centroid</strong>'ine en yakın ürünleri çeker, ardından <code>graph.purchased</code>'tan
                <strong style="color:var(--text);">social proof</strong> (kaç sipariş aldı) ile yeniden
                sıralar. Tek SELECT'te <code>VECTOR_SEARCH</code> + <code>GRAPH MATCH</code> — SQL
                Server 2025'in iki amiral özelliğinin birlikteliği.
            </p>
            <div class="dmc-card-footer">
                <span class="dmc-badge dmc-badge-positive">Aktif</span>
                <span class="dmc-card-link">İncele →</span>
            </div>
        </a>
    </div>
</section>

<section class="dmc-section">
    <div class="dmc-section-head">
        <span class="dmc-section-title">Demo veri tabanı</span>
        <span class="dmc-section-meta">@loadedAtTr.ToString("yyyy-MM-dd HH:mm") TR · @loadedAt.ToString("HH:mm") UTC</span>
    </div>
    <div class="dmc-grid dmc-grid-4">
        <div class="dmc-stat"><div class="dmc-stat-label">Ürün</div>             <div class="dmc-stat-value">@productCount.ToString("N0")</div></div>
        <div class="dmc-stat"><div class="dmc-stat-label">Müşteri</div>          <div class="dmc-stat-value">@customerCount.ToString("N0")</div></div>
        <div class="dmc-stat"><div class="dmc-stat-label">Sipariş</div>          <div class="dmc-stat-value">@orderCount.ToString("N0")</div></div>
        <div class="dmc-stat"><div class="dmc-stat-label">Sipariş satırı</div>   <div class="dmc-stat-value">@orderLineCount.ToString("N0")</div></div>
    </div>
    <div class="dmc-grid dmc-grid-4" style="margin-top: 1rem;">
        <div class="dmc-stat"><div class="dmc-stat-label">Kategori</div>         <div class="dmc-stat-value">@categoryCount.ToString("N0")</div></div>
        <div class="dmc-stat"><div class="dmc-stat-label">Vector'lü ürün</div>   <div class="dmc-stat-value">@embeddedCount.ToString("N0")</div></div>
        <div class="dmc-stat"><div class="dmc-stat-label">Cihaz</div>            <div class="dmc-stat-value">@deviceCount.ToString("N0")</div></div>
        <div class="dmc-stat"><div class="dmc-stat-label">RAG çağrısı</div>      <div class="dmc-stat-value">@queryLogCount.ToString("N0")</div></div>
    </div>
</section>

@code {
    private IReadOnlyList<FeaturedView>? featured;
    private int productCount, customerCount, orderCount, orderLineCount,
                categoryCount, deviceCount, queryLogCount, embeddedCount;
    private DateTime loadedAt;
    private DateTime loadedAtTr;

    private static readonly TimeZoneInfo TrTimeZone =
        TryGetTr() ?? TimeZoneInfo.CreateCustomTimeZone("TR", TimeSpan.FromHours(3), "TR", "TR");

    private static TimeZoneInfo? TryGetTr()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Europe/Istanbul"); } catch { }
        try { return TimeZoneInfo.FindSystemTimeZoneById("Turkey Standard Time"); } catch { }
        return null;
    }

    private string sqlVersionLabel = SqlServerVersionService.Fallback;

    protected override async Task OnInitializedAsync()
    {
        sqlVersionLabel = await SqlVersion.GetLabelAsync();
        loadedAt   = DateTime.UtcNow;
        loadedAtTr = TimeZoneInfo.ConvertTimeFromUtc(loadedAt, TrTimeZone);

        // Sequential — DbContext thread-safe değil
        productCount   = await Db.Products.AsNoTracking().CountAsync();
        customerCount  = await Db.Customers.AsNoTracking().CountAsync();
        orderCount     = await Db.Orders.AsNoTracking().CountAsync();
        orderLineCount = await Db.OrderLines.AsNoTracking().CountAsync();
        categoryCount  = await Db.ProductCategories.AsNoTracking().CountAsync();
        deviceCount    = await Db.Devices.AsNoTracking().CountAsync();
        queryLogCount  = await Db.QueryLogs.AsNoTracking().CountAsync();

        embeddedCount = await Db.Database
            .SqlQueryRaw<int>("SELECT COUNT(*) AS Value FROM vector.product_embedding WHERE embedding_ollama_768 IS NOT NULL OR embedding_openai_1536 IS NOT NULL")
            .FirstAsync();

        var ids = new[] { 1021, 1041, 1061, 1083, 1101, 1003 };
        var products = await Db.Products
            .Include(p => p.Category)
            .Where(p => ids.Contains(p.ProductId))
            .AsNoTracking()
            .ToListAsync();

        featured = products
            .OrderBy(p => Array.IndexOf(ids, p.ProductId))
            .Select(p => new FeaturedView(p.ProductId, p.Sku, p.Name, p.Category?.Name ?? "", p.Price))
            .ToList();
    }

    private record FeaturedView(int Id, string Sku, string Name, string Category, decimal Price);
}
