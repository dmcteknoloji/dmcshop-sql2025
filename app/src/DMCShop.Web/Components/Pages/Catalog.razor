@page "/katalog"
@rendermode InteractiveServer
@using DMCShop.Data
@using DMCShop.Domain.Entities
@using Microsoft.EntityFrameworkCore
@inject DMCShopDbContext Db

<PageTitle>Katalog — DMCShop</PageTitle>

<section class="dmc-hero" style="padding-bottom: 1rem;">
    <div class="dmc-hero-eyebrow">Katalog</div>
    <h1>@totalCount.ToString("N0") ürün, @categories.Count kategori</h1>
    <p class="dmc-hero-lead">
        Demo veri tabanındaki tüm ürünler. Kategoriye göre filtreleyin, ada veya fiyata göre
        sıralayın. Tıklayarak ürün detayına ve "Bunu alanlar bunu da aldı" graph önerilerine ulaşın.
    </p>
</section>

<div class="dmc-catalog">
    <aside class="dmc-filter">
        <div class="dmc-filter-title">Kategori</div>
        <input class="dmc-search-input" style="height: 36px; padding: 0.45rem 0.7rem; font-size: 0.86rem; margin-bottom: 0.6rem;"
               @bind="categorySearch" @bind:event="oninput" placeholder="Kategori ara…" />
        <div class="dmc-filter-list" style="max-height: 60vh; overflow-y: auto;">
            <button class="dmc-filter-item @(activeCat is null ? "active" : "")" @onclick="() => SetCategory(null)">
                <span>Tümü</span>
                <span class="dmc-filter-count">@totalCount.ToString("N0")</span>
            </button>
            @foreach (var c in FilteredCategories)
            {
                <button class="dmc-filter-item @(activeCat == c.CategoryId ? "active" : "")"
                        @onclick="() => SetCategory(c.CategoryId)">
                    <span>@c.Name</span>
                    <span class="dmc-filter-count">@c.Count.ToString("N0")</span>
                </button>
            }
        </div>
    </aside>

    <div>
        <div class="dmc-toolbar">
            <div class="dmc-toolbar-count">
                <strong style="color:var(--text);">@filteredCount.ToString("N0")</strong>
                <span> ürün</span>
                @if (activeCatName is not null)
                {
                    <span> · @activeCatName</span>
                }
                <span> · sayfa @page0 / @totalPages</span>
            </div>
            <div class="dmc-toolbar-sort">
                <input class="dmc-search-input" style="height: 38px; padding: 0.5rem 0.85rem; min-width: 220px;"
                       @bind="productSearch" @bind:event="oninput" @bind:after="OnSearchChanged" placeholder="Ürün ara…" />
                <select class="dmc-select" @bind="sortKey" @bind:after="ResetPage">
                    <option value="name">Ada göre (A–Z)</option>
                    <option value="price-asc">Fiyat (artan)</option>
                    <option value="price-desc">Fiyat (azalan)</option>
                </select>
            </div>
        </div>

        @if (busy)
        {
            <div class="dmc-loading">Yükleniyor…</div>
        }
        else if (pageItems.Count == 0)
        {
            <div class="dmc-empty">Bu kategoride / aramada ürün bulunamadı.</div>
        }
        else
        {
            <div class="dmc-grid dmc-grid-cat">
                @foreach (var p in pageItems)
                {
                    <a href="urun/@p.ProductId" class="dmc-pcard">
                        <ProductImage ProductId="p.ProductId" Name="@p.Name" CategoryName="@p.CategoryName" Sku="@p.Sku" Variant="card" />
                        <div class="dmc-pcard-body">
                            <div class="dmc-pcard-cat">@p.CategoryName</div>
                            <h3 class="dmc-pcard-name">@p.Name</h3>
                            <div class="dmc-pcard-price">@p.Price.ToString("N2") ₺</div>
                            <div class="dmc-pcard-foot">
                                <span>@p.Sku</span>
                                <span class="dmc-card-link">İncele →</span>
                            </div>
                        </div>
                    </a>
                }
            </div>

            <div class="dmc-pager">
                <button class="dmc-btn dmc-btn-ghost" @onclick="() => GotoPage(1)"           disabled="@(page0 <= 1)">«</button>
                <button class="dmc-btn dmc-btn-ghost" @onclick="() => GotoPage(page0 - 1)"   disabled="@(page0 <= 1)">‹ Önceki</button>
                <span class="dmc-pager-info">@page0 / @totalPages</span>
                <button class="dmc-btn dmc-btn-ghost" @onclick="() => GotoPage(page0 + 1)"   disabled="@(page0 >= totalPages)">Sonraki ›</button>
                <button class="dmc-btn dmc-btn-ghost" @onclick="() => GotoPage(totalPages)"  disabled="@(page0 >= totalPages)">»</button>
            </div>
        }
    </div>
</div>

<style>
    .dmc-pager {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        padding: 1rem 0;
    }
    .dmc-pager .dmc-btn { height: 38px; padding: 0 0.85rem; font-size: 0.88rem; }
    .dmc-pager-info {
        font-family: var(--font-mono);
        color: var(--text-muted);
        padding: 0 0.85rem;
        font-variant-numeric: tabular-nums;
    }
</style>

@code {
    private const int PageSize = 48;

    private bool busy;
    private int totalCount;
    private int filteredCount;
    private int page0 = 1;
    private int totalPages = 1;

    private int? activeCat;
    private string? activeCatName;
    private string sortKey         = "name";
    private string categorySearch  = string.Empty;
    private string productSearch   = string.Empty;

    // Her tuş vuruşunda DB sorgusu atmak Blazor SignalR pipeline'ını ve DbContext'i
    // tıkar (concurrent operation). 300 ms debounce + tek-uçucu CancellationTokenSource
    // yalnızca "yazma duraklayınca" arama tetikler.
    private CancellationTokenSource? searchCts;
    private readonly SemaphoreSlim loadGate = new(1, 1);

    private List<CategoryView> categories = new();
    private List<ProductView>  pageItems  = new();

    private IEnumerable<CategoryView> FilteredCategories =>
        string.IsNullOrWhiteSpace(categorySearch)
            ? categories
            : categories.Where(c => c.Name.Contains(categorySearch.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        totalCount = await Db.Products.AsNoTracking().CountAsync();

        // Kategori sayımları
        categories = await (
            from p in Db.Products.AsNoTracking()
            join c in Db.ProductCategories.AsNoTracking() on p.CategoryId equals c.CategoryId
            group p by new { c.CategoryId, c.Name } into g
            orderby g.Key.Name
            select new CategoryView(g.Key.CategoryId, g.Key.Name, g.Count())
        ).ToListAsync();

        await LoadPageAsync();
    }

    private async Task OnSearchChanged()
    {
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;
        try
        {
            await Task.Delay(300, token);
            page0 = 1;
            await LoadPageAsync();
        }
        catch (OperationCanceledException)
        {
            // Daha yeni bir tuş vuruşu geldi; bu çağrı atlanır.
        }
    }

    private async Task LoadPageAsync()
    {
        // Concurrent çağrıları seri hale getir — DbContext tek bir EF Core sorgusunu
        // aynı anda paylaşamaz; aksi halde "An attempt was made to use the context
        // while it is being configured" istisnası gelir.
        await loadGate.WaitAsync();
        busy = true;
        try
        {
            IQueryable<Product> q = Db.Products.AsNoTracking().Include(p => p.Category);

            if (activeCat is { } cid) q = q.Where(p => p.CategoryId == cid);

            if (!string.IsNullOrWhiteSpace(productSearch))
            {
                var needle = "%" + productSearch.Trim() + "%";
                q = q.Where(p =>
                    EF.Functions.Like(p.Name, needle) ||
                    EF.Functions.Like(p.Sku,  needle) ||
                    (p.DescriptionTr != null && EF.Functions.Like(p.DescriptionTr, needle)));
            }

            filteredCount = await q.CountAsync();
            totalPages    = Math.Max(1, (int)Math.Ceiling(filteredCount / (double)PageSize));
            if (page0 > totalPages) page0 = totalPages;

            q = sortKey switch
            {
                "price-asc"  => q.OrderBy(p => p.Price),
                "price-desc" => q.OrderByDescending(p => p.Price),
                _            => q.OrderBy(p => p.Name)
            };

            var products = await q
                .Skip((page0 - 1) * PageSize)
                .Take(PageSize)
                .ToListAsync();

            pageItems = products
                .Select(p => new ProductView(p.ProductId, p.Sku, p.Name, p.Category?.Name ?? "", p.Price))
                .ToList();
        }
        finally
        {
            busy = false;
            loadGate.Release();
        }
    }

    private async Task SetCategory(int? id)
    {
        activeCat     = id;
        activeCatName = id is null ? null : categories.FirstOrDefault(c => c.CategoryId == id)?.Name;
        page0         = 1;
        await LoadPageAsync();
    }

    private async Task ResetPage()
    {
        page0 = 1;
        await LoadPageAsync();
    }

    private async Task GotoPage(int p)
    {
        page0 = Math.Max(1, Math.Min(totalPages, p));
        await LoadPageAsync();
    }

    private record CategoryView(int CategoryId, string Name, int Count);
    private record ProductView(int ProductId, string Sku, string Name, string CategoryName, decimal Price);
}
