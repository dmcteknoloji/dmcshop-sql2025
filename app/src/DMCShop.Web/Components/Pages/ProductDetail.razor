@page "/urun/{ProductId:int}"
@rendermode InteractiveServer
@using DMCShop.Data
@using DMCShop.Domain.Dtos
@using DMCShop.Domain.Entities
@using DMCShop.Search
@using Microsoft.EntityFrameworkCore
@inject DMCShopDbContext Db
@inject GraphRecommendService Recommend

<PageTitle>@(product?.Name ?? "Ürün") — DMCShop</PageTitle>

@if (product is null)
{
    <div class="dmc-loading">Ürün yükleniyor…</div>
}
else
{
    <section class="dmc-product-hero">
        <ProductImage ProductId="product.ProductId"
                      Name="product.Name"
                      CategoryName="categoryName"
                      Sku="product.Sku"
                      Variant="hero" />

        <div class="dmc-product-info">
            <span class="dmc-badge">@categoryName</span>
            <h1 class="dmc-product-name">@product.Name</h1>

            <div class="dmc-product-meta-row">
                <span>SKU <code>@product.Sku</code></span>
                <span>·</span>
                <span>Ürün #@product.ProductId</span>
            </div>

            <p class="dmc-product-desc">@product.DescriptionTr</p>

            @if (!string.IsNullOrWhiteSpace(product.DescriptionEn))
            {
                <details>
                    <summary style="cursor:pointer; color:var(--text-muted); font-size:0.86rem; margin-top:1.25rem; user-select:none;">
                        English description
                    </summary>
                    <p class="dmc-product-desc-en">@product.DescriptionEn</p>
                </details>
            }

            <div class="dmc-product-price">@product.Price.ToString("N2") ₺</div>
        </div>
    </section>

    <section class="dmc-section">
        <div class="dmc-section-head">
            <span class="dmc-section-title">Bunu alanlar bunu da aldı</span>
            <span class="dmc-section-meta">graph MATCH · 2-hop</span>
        </div>

        @if (recommendations is null)
        {
            <div class="dmc-loading">Hesaplanıyor…</div>
        }
        else if (recommendations.Count == 0)
        {
            <div class="dmc-empty">Bu ürün için co-purchase önerisi henüz yok.</div>
        }
        else
        {
            <div class="dmc-grid dmc-grid-3">
                @foreach (var r in recommendations)
                {
                    <a href="urun/@r.RecommendedProductId" class="dmc-card">
                        <ProductImage ProductId="r.RecommendedProductId"
                                      Name="r.RecommendedName"
                                      CategoryName="r.CategoryName"
                                      Variant="card" />
                        <span class="dmc-badge" style="margin-top: 0.75rem; align-self: flex-start;">@r.CategoryName</span>
                        <h3 class="dmc-card-title">@r.RecommendedName</h3>
                        <div class="dmc-card-body">@r.Price.ToString("N2") ₺</div>
                        <div class="dmc-card-footer">
                            <span class="dmc-badge dmc-badge-accent">@r.CoBuyerCount müşteri birlikte aldı</span>
                            <span class="dmc-card-link">İncele →</span>
                        </div>
                    </a>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public int ProductId { get; set; }

    private Product? product;
    private string? categoryName;
    private IReadOnlyList<CoPurchaseRow>? recommendations;
    private int lastLoadedFor = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (ProductId == lastLoadedFor) return;
        lastLoadedFor = ProductId;

        product = await Db.Products
            .Include(p => p.Category)
            .AsNoTracking()
            .FirstOrDefaultAsync(p => p.ProductId == ProductId);

        categoryName    = product?.Category?.Name;
        recommendations = null;

        if (product is not null)
        {
            recommendations = await Recommend.CoPurchaseAsync(ProductId, topK: 9);
        }
    }
}
