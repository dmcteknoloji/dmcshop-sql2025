# Caddyfile — DMCShop HTTPS reverse proxy
#
# Self-signed (Caddy internal CA) mode için bu dosya, FQDN için
# tls internal kullanır. Tarayıcı "güvensiz" uyarısı verir, "devam et" ile
# geçilir.
#
# Production / Let's Encrypt için:
#   - Caddyfile başındaki FQDN'i kendi domain'inle değiştir
#   - "tls internal" satırını sil
#   - DNS A-record: <DOMAIN> → VM public IP
#   - NSG: 80 ve 443 açık
#   - Caddy 2 otomatik Let's Encrypt sertifika alır

dmcshop-eqaspinoarx3g.westeurope.cloudapp.azure.com {
    tls internal
    encode gzip zstd
    reverse_proxy localhost:5000 {
        flush_interval -1
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For   {remote_host}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    log {
        output stdout
        format console
        level INFO
    }
}

http://dmcshop-eqaspinoarx3g.westeurope.cloudapp.azure.com {
    redir https://{host}{uri} permanent
}
