# Caddyfile — DMCShop HTTPS (Let's Encrypt)
#
# Production: domain DNS A-record + Let's Encrypt otomatik sertifika.
# DNS A-record:  demo.dmcteknoloji.com → 20.71.172.88 (VM public IP)
# NSG açık portlar: 80 (Let's Encrypt HTTP-01 / TLS-ALPN-01 challenge), 443.
#
# Self-signed mode için: `tls internal` ekle, ACME email satırını kaldır.
# Detay: infra/caddy/README.md

{
    email iletisim@dmcteknoloji.com
}

demo.dmcteknoloji.com {
    encode gzip zstd
    reverse_proxy localhost:5000 {
        flush_interval -1
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For   {remote_host}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }
    log {
        output stdout
        format console
        level INFO
    }
}

# Eski Azure FQDN: yeni domain'e redirect (eski paylaşılan linkler kırılmasın)
dmcshop-eqaspinoarx3g.westeurope.cloudapp.azure.com {
    tls internal
    redir https://demo.dmcteknoloji.com{uri} permanent
}

# HTTP isteklerini HTTPS'e zorla
http://demo.dmcteknoloji.com, http://dmcshop-eqaspinoarx3g.westeurope.cloudapp.azure.com {
    redir https://demo.dmcteknoloji.com{uri} permanent
}
